{
  "name": "daycare-platform",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:app": "corepack pnpm --filter @daycare/app start",
    "dev:api": "./apps/api/gradlew -p apps/api bootRun",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "coverage:backend": "GRADLE_USER_HOME=.gradle-local ./apps/api/gradlew -p apps/api test jacocoTestReport --no-daemon",
    "coverage": "corepack pnpm coverage:backend && corepack pnpm -r --if-present test:coverage",
    "generate:api": "corepack pnpm --filter @daycare/api-client generate",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "pretty-format": "29.7.0"
    }
  }
}
