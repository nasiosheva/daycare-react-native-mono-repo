{
  "expo": {
    "name": "Umur Emas",
    "slug": "children-platform",
    "scheme": "children",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-notifications", "@react-native-firebase/app", "@react-native-firebase/auth", "@react-native-google-signin/google-signin"],
    "ios": { "bundleIdentifier": "com.children.platform", "supportsTablet": true, "googleServicesFile": "./GoogleService-Info.plist" },
    "android": { "package": "com.children.platform", "googleServicesFile": "./google-services.json" },
    "web": { "bundler": "metro", "output": "single" },
    "experiments": { "typedRoutes": true }
  }
}
