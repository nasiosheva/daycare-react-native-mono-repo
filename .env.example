EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Optional override. By default it is derived from EXPO_PUBLIC_API_URL by appending /realtime.
EXPO_PUBLIC_REALTIME_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional. Only needed for reverse geocoding (coordinates -> address) in the web build of the
# current-location module (src/location). Native reverse geocoding needs no key. Requires the
# Geocoding API enabled (with billing) on the same Google Cloud project as Firebase. Leave empty
# to get coordinates without an address on web.
EXPO_PUBLIC_GOOGLE_MAPS_GEOCODING_API_KEY=
POSTGRES_DB=daycare
POSTGRES_USER=daycare
POSTGRES_PASSWORD=daycare
FIREBASE_ISSUER_URI=https://securetoken.google.com/your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
PLATFORM_ADMIN_EMAILS=
LOCAL_AUTH_JWT_SECRET=
# Local-only account seeder. Local launchers activate the required Spring profile.
# Never set any of these in production.
LOCAL_SEED_ENABLED=false
LOCAL_SEED_ADMIN_EMAIL=admin@local.test
LOCAL_SEED_ADMIN_USERNAME=admin
LOCAL_SEED_ADMIN_DISPLAY_NAME="Local Admin"
LOCAL_SEED_ADMIN_PASSWORD=admin@local.test
# Optional, idempotent seed for the reference global curriculum (LearningLevel age bands +
# GoalCategory + GoalCategoryItem). Off by default so a schema reset stays empty; set to true to
# (re-)populate it. Safe in any environment (not local-only) - re-running is a no-op once seeded.
SEED_GLOBAL_CURRICULUM_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
