<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to trigger Termux's RUN_COMMAND plugin API (com.termux.app.RunCommandService).
         Termux itself must also have "allow-external-apps=true" set in
         ~/.termux/termux.properties before it will accept commands from this app. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declares that this app is a known caller of Termux's RUN_COMMAND service,
         matching the pattern used by Termux:Widget / Termux:Tasker plugins. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
